detectors/sumo/src/
detectors/s5/src/

# trained model weights (regenerate with detectors/sumo/finetune/run_all.py)
results/rq4/work/models/

# logs and scratch
*.log
p.html

# SUMO per-sample probabilities (regenerable, large)
results/rq4/work/prob/

